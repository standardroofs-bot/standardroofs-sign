# ==============================================================================
# STANDARD e-SIGN — COMMERCIAL SAAS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Web Application Base URL
NEXT_PUBLIC_APP_URL="https://sign.standardroofs.in"

# 32+ character random secret for signing secure session cookies
APP_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-production"

# ------------------------------------------------------------------------------
# DATABASE (Neon Serverless PostgreSQL or Supabase / AWS RDS)
# ------------------------------------------------------------------------------
# Pooled connection string (used at runtime by Next.js app)
DATABASE_URL="postgresql://neondb_owner:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection string (used by Prisma migrations & schema push)
DIRECT_URL="postgresql://neondb_owner:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# OBJECT STORAGE (Cloudflare R2 or AWS S3)
# ------------------------------------------------------------------------------
# Driver: "r2" (Production cloud storage) | "local" (fallback disk storage)
STORAGE_DRIVER="local"

# Cloudflare R2 Credentials
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="standard-esign-documents"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
# Endpoint format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# Local Disk Storage Directory (used when STORAGE_DRIVER="local")
STORAGE_DIR="./storage"

# ------------------------------------------------------------------------------
# BILLING & PAYMENTS (Razorpay Commercial Subscriptions & Checkouts)
# ------------------------------------------------------------------------------
# Razorpay API Credentials (from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Razorpay Subscription Plan IDs
RAZORPAY_PLAN_PRO="plan_xxxxxxxxxxxx"       # ₹1,499/mo Business Pro (100 GB)
RAZORPAY_PLAN_ENTERPRISE="plan_yyyyyyyyyyyy" # ₹4,999/mo Enterprise (1 TB)

# ------------------------------------------------------------------------------
# NOTIFICATIONS & DISPATCH
# ------------------------------------------------------------------------------
# Custom SMTP Server Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Standard e-Sign <noreply@standardesign.in>"

# Automated SMS & WhatsApp Gateways (Optional)
FAST2SMS_API_KEY=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
